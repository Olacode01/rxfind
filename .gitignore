.venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# Local call ledgers — state, not code.
# These contain confirm_tokens, which authorise placing a call. Never commit.
.rxfind_budget.json
.rxfind_runs.json*
.pharmacy_budget.json
.pharmacy_runs.json*

# Terminal run dumps written next to the skill script at runtime
contrib/skills/*/scripts/run_*.json

# Superseded by calle_driver.py + rxfind.py
calle_mcp_client.py

# Your real pharmacy list. Keep real numbers out of the repo — copy
# pharmacies.csv to this name and edit it for live runs, then
# export RXFIND_PHARMACIES=pharmacies.local.csv
pharmacies.local.csv

# Local demo planning notes
DEMO.md

# NOTE: runs/ is intentionally NOT ignored.
# The saved plan/run/result JSON is evidence the agent ran against a real call
# and is what makes replay mode work without spending credits.
# Phone numbers in these fixtures have been replaced with the reserved
# fictional range +1 555 01xx. Re-check before committing new ones.
